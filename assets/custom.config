/*
 * -------------------------------------------------
 *  DNAharvester - Custom Configuration File
 * -------------------------------------------------
 *  Use this file to specify your custom parameters
 *  and override default settings for your run.
 */

// Pipeline parameters
params {

    // Name for the workflow run to label run-specific output files.
    // If not provided, defaults to a random Nextflow's runName.
    workflow_run_name           = ''

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 1. Samplesheet and reference genomes
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Enter full path to samplesheet with sample IDs and paths to fastq files (required).
    // See Assets/samplesheet_example.csv for format details
    samplesheet                 = ''

    // Enter path to reference genome (required)
    reference                   = ''

    // Optional: Enter path to reference genome for competitive mapping.
    competitive_reference       = ''

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 2. Pipeline workflow steps
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Select which workflow steps to run by setting to 'true' or 'false'. See documentation for
    // details: https://github.com/NBISweden/DNAharvester/wiki/3.-Pipeline-steps

    // Main workflow steps:
    raw_fastq_qc                = 'true'
    fastq_processing            = 'true'
    processed_fastq_qc          = 'true'
    mapping                     = 'true'
    raw_bam_qc                  = 'true'
    bam_processing              = 'true'
    processed_bam_qc            = 'true'
    mapping_metrics             = 'true'

    // Bonus workflow steps:
    repeat_cpg_identification   = ''
    random_sampling_bam         = ''
    variant_calling             = ''
    iterative_assembly          = ''
    taxonomic_classification    = ''
    microbial_screening         = ''

    // Enter path to output directory (default: 'results' in the current working directory)
    outdir                      = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy' (default: 'copy')
    publish_mode                = 'copy'

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 3. FASTQ PROCESSING
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Read merging
    // Set to 'true' to perform read merging with FASTP (default: 'true')
    merge_reads               = 'true'

    // Keep unmerged reads
    // Set to 'true' to keep unmerged reads for downstream analysis (default: 'false')
    // Note: Only applicable if merge_reads is set to 'true'
    keep_unmerged_reads       = ''

    // AdaptClean
    // Set to 'true' to remove the leftover adapter sequences from single-end reads and
    // pair-end unmerged reads (default: 'false'). Details:
    // https://github.com/NBISweden/DNAharvester/wiki/3.-Pipeline-steps#fastq-processing
    adaptclean                = ''

    // Minimum read length
    // Set minimum read length for a read to be kept after adapter trimming and read
    // merging (default: 30). Optional: this parameters can be set to 'auto' to
    // estimate the minimum read length from the mapped reads. Details:
    // https://github.com/NBISweden/DNAharvester/wiki/3.-Pipeline-steps#fastq-processing
    readlength                = '30'

    // Kraken2 filtering
    // Set kraken2_filtering to 'true' to filter out contaminant reads (default: 'false').
    // The reads will be classified with Kraken2 against the Kraken2 database provided
    // below, and only the unclassified reads will be kept for downstream analysis.
    kraken2_filtering         = ''
    kraken2_database          = ''

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 4. MAPPING and COMPETITIVE MAPPING
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Set mapping tool for ancient and modern samples
    // DNAharvester currently supports 'bwa-aln', 'bwa-mem', 'bwa-aln-mem' and  'bowtie2'.
    // see documentation for details:
    // (https://github.com/NBISweden/DNAharvester/wiki/3.-Pipeline-steps#mapping)
    mapping_tool_ancient        = 'bwa-aln'
    mapping_tool_modern         = 'bwa-aln'

    // Set mapping parameters based on sample type: 'ancient' or 'modern'
    // Ancient
    bwa_aln_ancient_params      = '-l 1024 -n 0.01 -o 2'
    bwa_mem_ancient_params      = '-k 19 -r 2.5 -L 15'
    bowtie2_ancient_params      = '--sensitive'
    // Modern
    bwa_aln_modern_params       = ''
    bwa_mem_modern_params       = ''
    bowtie2_modern_params       = ''

    // Only if mapping_tool_ancient is set to 'bwa-aln-mem'
    // Set the read length to separate short and long reads. Short reads will be mapped
    // with bwa-aln, and long reads with bwa-mem (default: 70)
    split_readlen               = 70

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 5. BAM PROCESSING
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Mapping quality filtering (default: 25)
    mapping_quality             = 25

    // Sub-sampling of mapped reads only for AMBER analysis (default: 1000000)
    // Enter number of mapped reads to randomly extract from raw BAM files.
    // For a standard dataset, set to '1000000'. For refined analysis, set to '10000000'.
    subsample                   = '1000000'

    // PRESEQ - Set to 'true' to run preseq lc_extrap analysis, which predicts the number of
    // unique reads that would be observed as sequencing depth increases (default: 'false')
    preseq                      = ''

    // MapDamage2 (only applied when sample_type = ancient) - set mapdamage2_rescale to 'true' to
    // rescale BAM files using MapDamage2 - if not set, only the MapDamage2 plots will be
    // generated (default: 'false')
    mapdamage2_rescale          = ''

    // Remove transitions (only applied when sample_type = ancient) -  Set remove_transitions to
    // 'true' to remove transitions from BAM files. For single-stranded libraries, it will only
    // remove C -> T transitions. For double-stranded libraries, it will remove both C -> T and
    // G -> A transitions.
    remove_transitions          = ''

    // Samtools depth of coverage - Enter path to BED file with reference genome positions to
    // include in depth of coverage calculation (e.g. repeat masked BED file)
    // If the BED file is not provided, the entire reference genome will be used for depth
    // calculation. If the BED file is provided, the depth of coverage will be calculated only
    // for the positions specified in the BED file. If the BED file is not provided and
    // 'repeat_cpg_identification' is included in the workflow steps, the generated
    // repeat-masked BED file will be used for depth calculation.
    intervals                   = ''

    // Set position parameter to '-a' to calculates depth of coverage for all positions -
    // (including those with zero depth).
    positions                   = '-a'

    // Indel realignment - set to 'true' to perform indel realignment using GATK IndelRealigner
    indel_realignment           = 'true'

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 6. VARIANT CALLING
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // BCFTOOLS
    // Set variant_calling_bcftools to 'true' to do variant calling with BCFtools
    variant_calling_bcftools            = ''

    // Minimum base quality
    bcftools_base_quality = ''
    // Set to 'true' to keep non-variant sites in the output vcf file. beaware that this will
    // increase the size of the output file.
    bcftools_keep_non_variant_sites = ''
    // Minimum quality for a variant
    bcftools_variant_quality = ''
    // Minimum depth of coverage for a variant
    bcftools_variant_min_depth = ''
    // Maximum depth of coverage for a variant
    bcftools_variant_max_depth = ''
    // Variant gap size from indels
    bcftools_variant_gap_indels = ''
    // Set to 'true' to remove indels
    bcftools_remove_indels = ''
    // Set to 'true' to remove allelic imbalance
    bcftools_remove_allelic_imbalance = ''

    // ANGSD
    // Set variant_calling_angsd to 'true' to do variant calling with ANGSD
    variant_calling_angsd               = ''

    // ANGSD variant calling filters - DNAharvester runs per default
    // 'angsd -bam bamlist.txt -ref *.fasta -fai *.fai -doMaf 1 -doMajorMinor 1 -dogeno 1
    // -docounts 1 -doGlf 2 -GL 1 -doPost 1 -doBcf 1'
    // Provide additional parameters that are passed to the ANGSD command line,
    // e.g. '-uniqueOnly 1 -remove_bads 1 -baq 1 -C 50 -minMapQ 25 -minQ 30 -minMaf 0.05'
    angsd_filters                       = ''

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 7. Iterative Assembly (MIA)
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Only applied if iterative_assembly is set to 'true' in the workflow steps
    // Provide reference mitochondrial genome for iterative assembly.
    mtDNA_reference             = ''

    // Parameters for consensus calling
    // Minimum read depth required to call a base
    coverage_threshold = '3'
    // Minimum fraction of reads supporting the base
    call_fraction = '0.66'
    // Minimum allele quality for consensus calling
    quality_threshold = '40'

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 8. Taxonomic Classification
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Only applied if taxonomic_classification is set to 'true' in the workflow steps

    // Set mapping tool for Taxonomic classification
    // DNAharvester currently supports 'bwa-aln', 'bwa-mem', 'bwa-aln-mem' and  'bowtie2'.
    // (default: bwa-aln). See documentation for details:
    // https://github.com/NBISweden/DNAharvester/wiki/3.-Pipeline-steps#taxonomic-classification
    tc_mapping_tool             = 'bwa-aln'

    // Provide reference database for taxonomic classification (e.g. a database of mitogenomes in
    // fasta format). The processed reads will be mapped to this database comperatively and an
    // idxstats report will be generated.
    tc_reference_database       = ''

    // Mapping quality filter for taxonomic classification (default: 25)
    tc_mapping_quality          = 25

    // IMPORTANT: Set the desired parameters for the selected mapping tools in the section
    // "MAPPING/COMPETITIVE MAPPING" above.

    ////////////////////////////////////////////////////////////////////////////////////////////////
    // 9. Microbial Screening
    ////////////////////////////////////////////////////////////////////////////////////////////////

    // Only applied if microbial_screening is set to 'true' in the workflow steps

    // Set mapping tool for Microbial screening
    // DNAharvester currently supports 'bwa-aln', 'bwa-mem', 'bwa-aln-mem' and  'bowtie2'.
    // (default: bwa-aln). See documentation for details:
    // https://github.com/NBISweden/DNAharvester/wiki/3.-Pipeline-steps#microbial-screening
    ms_mapping_tool             = 'bwa-aln'

    // Provide microbial reference database for microbial screening (e.g. a database of bacterial
    // and viral genomes in fasta format). The unmapped reads from the host mapping step will be
    // mapped to this database and FIlTERBAM stats file and a custom report will be generated.
    ms_reference_database       = ''

    // Mapping quality filter for microbial screening (default: 1)
    ms_mapping_quality          = 1

    // IMPORTANT: Set the desired parameters for the selected mapping tools in the section
    // "MAPPING/COMPETITIVE MAPPING" above.

    /////////////////////////////////////////////////////////////////
    // 10. Additional parameters
    /////////////////////////////////////////////////////////////////

    // Check "config/modules.config" for additional tool-specific parameters
}

// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized directory with apptainer images
apptainer.cacheDir         = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for Dardel
params.project             = ''
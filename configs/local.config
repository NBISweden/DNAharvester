// Profile for running DNAharvester locally (e.g. on a login node) without
// submitting SLURM jobs. Resource sizing mirrors configs/dardel/dardel_test.config,
// with the SLURM-specific executor/clusterOptions/scratch settings removed.

process {
    // Modified process specifications for local runs
    cpus   = 4
    memory = 4.GB
    time   = 1.h


    //////////////////////////////////////////////////////////////////////////////////////////////
    // INPUT CHECK, FASTQ_PROCESSING and QC
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_samplesheet_check        { cpus = 1;  memory = 1.GB;   time = 1.h }
    withLabel: process_gunzip                   { cpus = 1;  memory = 1.GB;   time = 1.h }
    withLabel: process_fastqc                   { cpus = 1;  memory = 4.GB;   time = 1.h }
    withLabel: process_multiqc                  { cpus = 1;  memory = 1.GB;   time = 1.h }
    withLabel: process_fastp                    { cpus = 1;  memory = 4.GB;   time = 1.h }
    withLabel: process_adapterremoval           { cpus = 1;  memory = 4.GB;   time = 1.h }
    withLabel: process_adaptclean               { cpus = 1;  memory = 1.GB;   time = 1.h }
    withLabel: process_kraken2                  { cpus = 1;  memory = 80.GB;   time = 1.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // Mapping
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_bwa_index                { cpus = 4;  memory = 4.GB;  time = 1.h }
    withLabel: process_bwa_aln                  { cpus = 8;  memory = 8.GB;  time = 1.h }
    withLabel: process_bwa_mem                  { cpus = 8;  memory = 8.GB;  time = 1.h }
    withLabel: process_bwa_samse                { cpus = 8;  memory = 8.GB;  time = 1.h }
    withLabel: process_bwa_aln_mem              { cpus = 8;  memory = 8.GB;  time = 1.h }
    withLabel: process_split_fastq              { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_bowtie2_build            { cpus = 4;  memory = 4.GB;  time = 1.h }
    withLabel: process_bowtie2                  { cpus = 8;  memory = 8.GB;  time = 1.h }
    withLabel: process_samtools_faidx           { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_fai_to_bed               { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_samtools_view_regions    { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_fai2bed                  { cpus = 1;  memory = 1.GB;  time = 1.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // RAW_BAM_QC, BAM_PROCESSING and QC
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_amber                        { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_create_amber_samplesheet     { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_estimate_read_len_cutoff     { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_mapdamage2                   { cpus = 1;  memory = 2.GB;  time = 1.h  }
    withLabel: process_deamstrip                    { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_rm_transitions               { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_view_subsample      { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_view_mq             { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_rm_short_reads               { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_merge               { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samremovedup                 { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_flagstat            { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_depth_mean          { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_idxstats            { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_samtools_unmapped_reads      { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_preseq                       { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_plot_preseq                  { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_gatk_indel_realigner         { cpus = 2;  memory = 4.GB;  time = 1.h  }
    withLabel: process_create_sequence_dictionary   { cpus = 1;  memory = 1.GB;  time = 1.h  }


    //////////////////////////////////////////////////////////////////////////////////////////////
    // MAPPING_ITERATIVE_ASSEMBLER
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_mapping_iterative_assembler  { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel: process_consensus_call_mia           { cpus = 1; memory = 1.GB; time = 1.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // REPEAT_CPG_IDENTIFICATION
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_repeatmodeler            { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_repeatmasker             { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_create_cpg_bed           { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_create_repeats_bed       { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_create_repma_bed         { cpus = 1;  memory = 1.GB;  time = 1.h  }
    withLabel: process_create_repma_cpg_bed     { cpus = 1;  memory = 1.GB;  time = 1.h  }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // STATS OUTPUT
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_mapping_metrics_lib            { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_mapping_metrics_sample         { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_sort_metrics               { cpus = 1;  memory = 1.GB;  time = 1.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // VARIANT_CALLING
    //////////////////////////////////////////////////////////////////////////////////////////////

    // BCFTools
    withLabel: process_bcftools_call                    { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel: process_bcftools_filter                  { cpus = 1; memory = 1.GB; time = 1.h  }
    withLabel: process_bcftools_rm_indels               { cpus = 1; memory = 1.GB; time = 1.h  }
    withLabel: process_bcftools_rm_allelic_imbalance    { cpus = 1; memory = 1.GB; time = 1.h  }
    withLabel: process_bcftools_stats                   { cpus = 1; memory = 1.GB; time = 1.h  }

    // ANGSD
    withLabel: process_angsd_dohaplocal                 { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel: process_angsd_haplotoplink               { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel: process_angsd_variant_calling            { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel: process_haplotofasta                     { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel: process_plink_recode                     { cpus = 1; memory = 1.GB; time = 1.h }

    // DeepVariant
    withLabel: process_deepvariant                      { cpus = 1; memory = 4.GB; time = 1.h }
    withLabel: process_filter_variants                  { cpus = 1; memory = 1.GB; time = 1.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // MICROBIAL_SCREENING
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_filterbam            { cpus = 2;  memory = 8.GB;  time = 1.h }
    withLabel: process_filterbam_plot       { cpus = 2;  memory = 8.GB;  time = 1.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // Sexing
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_x_chr_sexing        { cpus = 1;  memory = 1.GB;  time = 2.h }
    withLabel: process_y_chr_sexing        { cpus = 1;  memory = 1.GB;  time = 2.h }
    withLabel: process_xy_ratio_sexing     { cpus = 1;  memory = 1.GB;  time = 2.h }

    //////////////////////////////////////////////////////////////////////////////////////////////
    // Others/Shared
    //////////////////////////////////////////////////////////////////////////////////////////////

    withLabel: process_bedtools_subtract    { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_merge_idxstats       { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_sort_idxstats        { cpus = 1;  memory = 1.GB;  time = 1.h }
    withLabel: process_samtools_index       { cpus = 1;  memory = 1.GB;  time = 1.h }
}

// No executor block - Nextflow defaults to the local executor, running tasks
// directly on the machine that launched `nextflow run` (no SLURM submission).

apptainer {
    enabled        = true
}

process {
    cpus   = 1
    memory = 6.GB
    time   = 1.h
    // Tools specfic configurations

    withLabel: process_fastp {
        cpus   = 6
        memory = 36.GB
        time   = 6.h
    }
    withLabel: process_adapterremoval {
        cpus   = 6
        memory = 36.GB
        time   = 6.h
    }
    withLabel: process_bwa_aln {
        cpus   = 12
        memory = 72.GB
        time   = 4.d
    }
    withLabel: process_bwa_samse {
        cpus   = 12
        memory = 72.GB
        time   = 6.h
    }
    withLabel: process_repeatmodeler {
        cpus   = 3
        memory = 18.GB
        time   = 1.d
    }
    withLabel: process_repeatmasker {
        cpus   = 3
        memory = 18.GB
        time   = 1.d
    }
    withLabel: process_angsd {
        cpus   = 3
        memory = 18.GB
        time   = 4.d
    }
    withLabel: process_mia {
        cpus   = 16
        memory = 14.GB
        time   = 1.d
    }


    withLabel: process_single {
        cpus   = 1
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_high {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_long {
        time   = 1.h
    }
    withLabel: process_high_memory {
        memory = 6.GB
    }
}
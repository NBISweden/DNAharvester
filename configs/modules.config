    withName: 'PBQC_FLAGSTAT_MERGED_BAM_LIB' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/3_processed_bams/merged_bam_lib/samtools-flagstat/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }

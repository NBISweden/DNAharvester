// This file contains process-specific configuration for all workflow steps in DNAharvester.
// The process section defines:
//   - publishDir: Output directory paths and filename handling for each process
//   - ext.args: Additional arguments to be passed to the underlying tools.
//   - errorStrategy: How to handle process failures (alloed values: 'ignore', 'retry', 'finish', 'terminate')

process {
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // 1. RAW_FASTQ_QC
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    withName: 'RFQC_FASTQC' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/0_raw_fastq/fastqc/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RFQC_MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/0_raw_fastq/multiqc/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // 2. FASTQ_PROCESSING
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    withName: 'FP_FASTP' {
        ext.args   = {
            def readlength = (params.readlength == 'auto') ? 20 : params.readlength
            "-l ${readlength}"
        }
        publishDir = [
            path: { "${params.outdir}/01_processed_fastq/fastp/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FP_ADAPTERREMOVAL' {
        ext.args   = {
            def readlength = (params.readlength == 'auto') ? 20 : params.readlength
            "--min-length ${readlength}"
        }
        publishDir = [
            path: { "${params.outdir}/01_processed_fastq/adapterremoval/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FP_ADAPTCLEAN' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/01_processed_fastq/adaptclean/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FP_ADAPTCLEAN' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/01_processed_fastq/kraken2/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FP_KRAKEN2' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/01_processed_fastq/kraken2/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // 3. PROCESSED_FASTQ_QC
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    withName: 'PFQC_FASTQC' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/1_processed_fastq/fastqc/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PFQC_MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/1_processed_fastq/multiqc/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // 4. MAPPING
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    withName: 'M_BWA_ALN' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'M_BWA_MEM' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'M_BWA_ALN_MEM_MERGE' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'M_BOWTIE2' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'M_RAW_BAM_INDEX' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // 5. COMPETITIVE MAPPING
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    withName: 'CM_BWA_ALN' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_BWA_MEM' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_BWA_ALN_MEM_MERGE' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_BOWTIE2' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_SAMTOOLS_INDEX_RAW' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_SAMTOOLS_VIEW_TARGET' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_SAMTOOLS_INDEX_TARGET' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/02_raw_bams/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_FLAGSTAT_DECOY' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/2_raw_bams/samtools-flagstat_decoy/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CM_MULTIQC_DECOY' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/2_raw_bams/multiqc_decoy/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : "decoy_${filename}"}
        ]
    }


    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // 6. RAW_BAM_QC
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    withName: 'RBQC_SAMTOOLS_FLAGSTAT' {
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/2_raw_bams/samtools-flagstat/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RBQC_SAMTOOLS_VIEW_SUBSAMPLE' {
            // Additional arguments (optional)
            ext.args      = { "" }
    }

    withName: 'RBQC_AMBER' {
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/2_raw_bams/amber/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }

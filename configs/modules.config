    }

    withName: 'BP_AMBER' {
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/3_processed_bams/amber/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BP_MAPDAMAGE2' {
        ext.args   = { "" }
        publishDir = [
            path: { "${params.outdir}/00_qc_reports/3_processed_bams/mapdamage2/" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BP_SAMREMOVEDUP_SAMPLE' {
        publishDir = [
            path: { "${params.outdir}/03_processed_bams/" },
            mode: params.publish_mode,
            // Only publish if GATK indel realignment is NOT enabled
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                params.indel_realignment.toBoolean() ? null : filename
            }
        ]
    }

    withName: 'BP_SAMREMOVEDUP_SAMPLE_INDEX' {
        publishDir = [
            path: { "${params.outdir}/03_processed_bams/" },
            mode: params.publish_mode,

// Adapted from https://github.com/nf-core/configs/blob/master/conf/pdc_kth.config

def clusterOptionsCreator = { mem, time, cpus ->
    List clusterOpts = [ "-A $params.project ${params.clusterOptions ?: ''}" ]
    if (time < 7.d && mem <= 222.GB && cpus < 256) {
        clusterOpts << '-p shared'
    } else if (time < 1.d) {
        // Shortish
        if (mem > 222.GB) {
            clusterOpts << '-p memory,main'
        } else {
            clusterOpts << '-p main'
        }
    } else {
        // Not shortish
        if (mem > 222.GB) {
            clusterOpts << '-p memory'
        } else {
            clusterOpts << '-p long'
        }
    }
    if (!mem || mem < 6.GB) {
        // Impose minimum memory if request is below
        clusterOpts << '--mem=6G'
    }
    return clusterOpts.join(' ')
}

process {
    executor       = 'slurm'
    clusterOptions = { clusterOptionsCreator(task.memory, task.time, task.cpus) }
    // There is no node local storage, but there is a scratch space.
    scratch        = '$PDC_TMP'

    // Modified process specifications for Dardel
    cpus   = 8
    memory = 8.GB
    time   = 1.h


    // Tools specfic configurations
    withLabel: process_fastp {
        cpus   = 8
        memory = 8.GB
        time   = 1.h
    }
    withLabel: process_bwa_aln {
        cpus   = 16
        memory = 16.GB
        time   = 1.h
    }
    withLabel: process_bwa_samse {
        cpus   = 16
        memory = 16.GB
        time   = 1.h
    }
     withLabel: process_bowtie2 {
        cpus   = 8
        memory = 8.GB
        time   = 1.h
    }
    withLabel: process_bwa_aln_mem {
        cpus   = 16
        memory = 16.GB
        time   = 1.h
    }
    withLabel: process_repeatmodeler {
        cpus   = 4
        memory = 4.GB
        time   = 1.h
    }
    withLabel: process_repeatmasker {
        cpus   = 4
        memory = 4.GB
        time   = 1.h
    }
    withLabel: process_angsd {
        cpus   = 8
        memory = 8.GB
        time   = 6.h
    }
    withLabel: process_kraken2 {
        cpus   = 20
        memory = 110.GB
        time   = 2.h
    }
    withLabel: process_mia {
        cpus   = 8
        memory = 8.GB
        time   = 1.d
    }
    withLabel: process_filterbam {
        cpus   = 8
        memory = 48.GB
        time   = 1.h
    }
    withLabel: process_filterbam_plot {
        cpus   = 8
        memory = 48.GB
        time   = 1.h
    }


    // General process specifications
    withLabel: process_single {
        cpus   = 1
        memory = 1.GB
        time   = 1.h
    }
    withLabel: process_low {
        cpus   = 4
        memory = 4.GB
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 8
        memory = 8.GB
        time   = 1.h
    }
    withLabel: process_high {
        cpus   = 16
        memory = 16.GB
        time   = 1.h
    }
    withLabel: process_long {
        cpus   = 8
        memory = 8.GB
        time   = 1.d
    }
    withLabel: process_high_memory {
        cpus   = 16
        memory = 16.GB
        time   = 1.h
    }
}
apptainer {
    enabled        = true
    envWhitelist   = 'PDC_TMP'
}




    // General process specifications
    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
        time   = 4.h
    }
    withLabel: process_low {
        cpus   = 4
        memory = 4.GB
        time   = 6.h
    }
    withLabel: process_medium {
        cpus   = 16
        memory = 16.GB
        time   = 12.h
    }
    withLabel: process_high {
        cpus   = 64
        memory = 64.GB
        time   = 1.d
    }
    withLabel: process_long {
        cpus   = 16
        memory = 16.GB
        time   = 4.d

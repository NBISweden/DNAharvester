// Nextflow configuration file

manifest {
    name                      = 'DNAharvester pipeline'
    author                    = 'Bilal Sharif, Verena Kutschera'
    homePage                  = 'https://github.com/NBISweden/DNAharvester'
    description               = 'A novel pipeline for processing and analyzing extremely degraded DNA'
    mainScript                = 'main.nf'
    nextflowVersion           = '!>=23.04.1'
    version                   = '0.1.4'
}

// Default pipeline parameters
// Override them in assets/custom.config
params {

    // Name for the workflow run to label run-specific output files.
    // If not provided, defaults to a random Nextflow's runName.

    workflow_run_name           = ''

    /////////////////////////////////////////////////////////////////
    // Samplesheet and reference genomes
    /////////////////////////////////////////////////////////////////

    // Enter path to samplesheet with sample IDs and paths to fastq files (required)
    // see `assets/samplesheet-example.csv` for the format
    samplesheet                 = ''

    // Enter path to reference genome assembly (required)
    reference                   = ''

    // Optional: if the reads should be mapped to the reference genome assembly concatenated
    // with a decoy genome assembly. (e.g. your species' genome plus the human genome)
    competitive_reference       = ''

    /////////////////////////////////////////////////////////////////
    // Pipeline steps and outputs
    /////////////////////////////////////////////////////////////////

    // Workflow steps to be executed - Set to 'true' to execute the step, or leave empty to skip the step.

    // Main workflow steps:
    fastq_processing            = 'true'
    processed_fastq_qc          = 'true'
    mapping                     = 'true'
    raw_bam_qc                  = 'true'
    bam_processing              = 'true'
    processed_bam_qc            = 'true'
    stats_output                = 'true'

    // Bonus workflow steps:
    repeat_cpg_identification   = ''
    random_sampling_bam         = ''
    variant_calling             = ''
    iterative_assembly          = ''
    species_identification      = ''
    microbial_screening         = ''


    // Enter path to output directory
    outdir                      = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode                = 'copy'

    /////////////////////////////////////////////////////////////////
    // FASTQ PROCESSING
    /////////////////////////////////////////////////////////////////

    // Fastp - Enter minimum read length for a read to be kept after adapter trimming and read merging (default: 20)
    // Optional: set readlength to 'auto', if you want to estimate the lower read length threshold <link to github>.
    readlength                  = '30'

    // Kraken2 - Set to 'true' to filter fastq files with Kraken2 database (negative filtering)
    kraken2                     = ''
    // Enter path to Kraken2 database
    kraken2_db                  = ''

    /////////////////////////////////////////////////////////////////
    // MAPPING
    /////////////////////////////////////////////////////////////////

    // Select mapping tool - for mapping to reference or competitive reference genome
    mapping_tool                = 'bwa-aln' // Options: 'bwa-aln-mem' and 'bwa-aln' and 'bowtie2'

    // Check "config/modules.config" for ancient DNA specific parameters

    /////////////////////////////////////////////////////////////////
    // BAM PROCESSING
    /////////////////////////////////////////////////////////////////

    // Mapping quality filtering, default 25
    mapping_quality             = 25

    // AMBER - Enter number of mapped reads to extract for analysis with samtools view --subsample
    // For a standard dataset, set to '1000000'. For refined analysis, set to '10000000'.
    subsample                   = '1000000'

    // PRESEQ - Set to 'true' to run the preseq lc_extrap analysis on all samples, which predicts the
    // number of unique reads that would be observed as sequencing depth increases.
    preseq                      = ''

    // MapDamage2 - set mapdamage2_rescale to 'true' to rescale the BAM files using MapDamage2.
    // If not set, only the MapDamage2 plots will be generated.
    mapdamage2_rescale          = ''

    // Set remove_transitions to 'true' to remove transitions from BAM files.
    // For single-stranded libraries, it will only remove C -> T transitions.
    // For double-stranded libraries, it will remove both C -> T and G -> A transitions.
    remove_transitions          = ''

    // Samtools depth of coverage - Enter path to BED file with reference genome positions
    // to include in depth of coverage calculation (e.g. repeat masked BED file)
    // If the BED file is not provided, the entire reference genome will be used for depth calculation.
    // If the BED file is not provided but 'repeat_cpg_identification' is included in the workflow steps,
    // the generated repeat-masked BED file will be used for depth calculation.
    intervals                   = ''

    // Set position parameter to '-a' to calculates depth of coverage for all positions (including those with zero depth).
    positions                   = '-a'

    /////////////////////////////////////////////////////////////////
    // VARIANT CALLING - BCFtools
    /////////////////////////////////////////////////////////////////

    // BCFTOOLS
    // Set variant_calling_bcftools to 'true' to do variant calling with BCFtools
    variant_calling_bcftools            = ''

    // bcftools filters
    bcftools_base_quality               = ''           // Minimum base quality
    bcftools_keep_non_variant_sites     = ''           // Set to 'true' to keep non-variant sites in the output vcf file. beaware that this will increase the size of the output file.
    bcftools_variant_quality            = ''           // Minimum quality for a variant
    bcftools_variant_min_depth          = ''           // Minimum depth of coverage for a variant
    bcftools_variant_max_depth          = ''           // Maximum depth of coverage for a variant
    bcftools_variant_gap_indels         = ''           // Variant gap size from indels
    bcftools_remove_indels              = ''           // Set to 'true' to remove indels
    bcftools_remove_allelic_imbalance   = ''           // Set to 'true' to remove allelic imbalance

    /////////////////////////////////////////////////////////////////
    // VARIANT CALLING - ANGSD
    /////////////////////////////////////////////////////////////////

    // ANGSD
    // Set variant_calling_angsd to 'true' to do variant calling with ANGSD
    variant_calling_angsd               = ''


    // ANGSD variant calling filters - DNAharvester runs per default
    // 'angsd -bam bamlist.txt -ref *.fasta -fai *.fai -doMaf 1 -doMajorMinor 1 -dogeno 1 -docounts 1 -doGlf 2 -GL 1 -doPost 1 -doBcf 1'
    // Provide additional parameters that are passed to the ANGSD command line,
    // e.g. '-uniqueOnly 1 -remove_bads 1 -baq 1 -C 50 -minMapQ 25 -minQ 30 -minMaf 0.05 -minInd 1 -SNP_pval 1e-6'
    angsd_filters                       = '-uniqueOnly 1 -remove_bads 1'

    /////////////////////////////////////////////////////////////////
    // Iterative assembly of mitochondrial DNA
    /////////////////////////////////////////////////////////////////

    // Only if iterative_assembly is set to 'true' in the workflow steps
    // mitochondrial reference genome for iterative assembly of mitochondrial DNA using MIA (mapping-iterative-assembler)
    mtDNA_reference             = ''

    // Parameters for iterative assembly of mitochondrial DNA using MIA (mapping-iterative-assembler) - modify if needed
    coverage_threshold          = '3'
    call_fraction               = '0.66'
    quality_threshold           = '40'

    /////////////////////////////////////////////////////////////////
    // Taxonomic Classification
    /////////////////////////////////////////////////////////////////

    // Only if taxonomic_classification is set to 'true' in the workflow steps

    // reference database for taxonomic classification mapping - likely a large dataset of mitogenomes
    tc_reference_database       = ''

    // Select mapping tool - for Taxonomic Classification
    tc_mapping_tool             = 'bowtie2'     // Options: 'bwa-aln-mem' and 'bwa-aln' and 'bowtie2'

    // Mapping quality filter for taxonomic classification - default is 25
    tc_mapping_quality          = 25           // Mapping quality filter for taxonomic classification (default: 25)

    /////////////////////////////////////////////////////////////////
    // Microbial Screening
    /////////////////////////////////////////////////////////////////

    // Only if microbial_screening is set to 'true' in the workflow steps.
    // It will screen unmapped reads from the main reference genome mapping against a microbial database

    // reference database for microbial screening - e.g. NCBI Animal Pathogen database
    ms_reference                = ''

    // Select mapping tool - for Microbial Screening
    ms_mapping_tool             = 'bowtie2'     // Options: 'bwa-aln-mem' and 'bwa-aln' and 'bowtie2'

    // Mapping quality filter for microbial screening - default is 1
    ms_mapping_quality          = 1           // Mapping quality filter for microbial screening (default: 1)

    /////////////////////////////////////////////////////////////////
    // Additional parameters
    /////////////////////////////////////////////////////////////////

    // Check "config/modules.config" for additional tool-specific parameters

    // MultiQC
    multiqc_config         = null
    multiqc_extra_config   = null
    multiqc_logo           = null

}

// Module- (tool-)specific parameter configurations
// If required, override tool-specific parameters here using process selectors,
// i.e. the same syntax as in 'configs/modules.config'
includeConfig 'configs/modules.config'

// Nextflow parameters

// Path to work directory for intermediate files
workDir                    = 'work'

// Execute the script using the cached results, useful to continue executions that was stopped by an error.
resume                     = true

// If run with -profile conda or -profile mamba, provide path to centralized directory with conda environments
conda.cacheDir             = null

// If run with -profile apptainer, provide path to centralized directory with apptainer images
apptainer.cacheDir       = null

// Cluster options
params.clusterOptions      = ''

// Compute project ID for Dardel
params.project             = ''


// setup the error strategy
process {
    errorStrategy = 'finish'
}

executor {
    name = 'slurm'
    queueSize = 300
    pollInterval = '5 sec'
    exitReadTimeout = '60 sec'
    submitRateLimit = '3 sec'
}

// Compute resources from nf-core
includeConfig 'configs/nf-core-defaults.config'

// Profiles for pipeline execution

profiles {

    conda {
        conda.enabled         = true
    }

    mamba {
        conda.enabled         = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
    }

    singularity {
        singularity.enabled   = true
    }

    apptainer {
        apptainer.enabled     = true
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }

    // Test profile for tiny dataset
    test {
        includeConfig 'configs/test.config'
    }

    // Profiles for the PDC cluster Dardel
    // Profile for genome-wide datasets (ca. human genome size)
    dardel {
        includeConfig 'configs/dardel/dardel.config'
    }

    // Profile for test run with tiny dataset
    dardeltest {
        includeConfig 'configs/dardel/dardel-test.config'
    }

}

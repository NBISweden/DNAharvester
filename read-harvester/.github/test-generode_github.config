// Template file for pipeline configuration

// Pipeline parameters

params {

    // Pipeline inputs

    // Enter full path to samplesheet with sample IDs and paths to fastq files (incl. information if single-end or paired-end)
    // TO DO expand samplesheet to include info on strandedness and damage treatment
    samplesheet        = 'samplesheet_testdata_generode-rhino.csv'
    // Enter path to reference genome assembly
    reference          = 'https://raw.githubusercontent.com/NBISweden/GenErode/refs/heads/main/.test/data/references/sumatran_rhino.fasta'

    // Pipeline steps to be run (comma-separated list, full list: 'fastq_processing,processed_fastq_qc,mapping,raw_bam_qc,bam_processing,processed_bam_qc,random_sampling_bam')
    steps              = 'fastq_processing,processed_fastq_qc,mapping,raw_bam_qc,bam_processing,processed_bam_qc,random_sampling_bam'

    // Pipeline outputs
    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'


    // Tool specific parameters
    // Fastp
    // Enter minimum read length for a read to be kept after adapter trimming and read merging (default: 20)
    // Optional: set readlength to 'auto', if you want to estimate the lower read length threshold using script <link to github>.
    readlength         = '20'

    // bwa-index
    // 'is' for small reference genomes such as mitogenomes, 'bwtsw' for large reference genomes
    algorithm          = 'is'

    // bwa-aln
    // Check "config/modules.config" for ancient DNA specific parameters

    // AMBER: samtools view subsample
    // Number of reads to extract for analysis in AMBER with samtools view --subsample
    // For test dataset, set to 1000. For a standard dataset, set to 1000000. For refined analysis, set to 10000000.
    subsample          = 1000

    // PRESEQ
    // Set to 'true' to run the preseq lc_extrap analysis, which predicts the number of unique reads that would be observed as sequencing depth increases.
    preseq            = 'false'

    // Samtools depth
    // '' to exclude positions with zero depth
    // '-a' to output all positions (including those with zero depth)
    positions          = ''
    // Enter path to BED file with reference genome positions to include in depth calculation (e.g. repeat-mask BED file)
    // '' to run depth calculation on the entire reference genome
    intervals          = ''

}

// Nextflow parameters

// Execute the script using the cached results, useful to continue executions that was stopped by an error.
resume                   = true

// If run with -profile conda or -profile mamba, provide path to centralized directory with conda environments
conda.cacheDir           = null

// If run with -profile singularity or -profile dardel, provide path to centralized directory with singularity images
singularity.cacheDir     = null

// Cluster options, e.g. for the UPPMAX compute project (like '-A snicxxx-yyy')
process.clusterOptions   = null

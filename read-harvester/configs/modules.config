process {
    // INPUT_CHECK
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/input_check/raw_reads/FastQC/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/input_check/raw_reads/multiqc/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // MERGE_FILTER_READS
    withName: 'FASTP' {
        ext.args   = { "-l ${params.readlength}" }
        publishDir = [
            path: { "${params.outdir}/processed_reads/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // MAPPING
    withName: 'BWA_INDEX' {
        ext.args   = { "-a bwtsw" } // for large genomes (size of human genome). Override in custom config file.
    }

    withName: 'BWA_ALN' {
        ext.args   = { "-l 16500 -n 0.01 -o 2" } // mapping parameters for ancient DNA
    }

    withName: 'BWA_SAMSE' {
        publishDir = [
            path: { "${params.outdir}/mapped_reads/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_MERGE_INDEX' {
        publishDir = [
            path: { "${params.outdir}/mapped_reads/merged_per_index/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMREMOVEDUP_INDEX' {
        publishDir = [
            path: { "${params.outdir}/mapped_reads/merged_per_index_samremovedup1/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_MERGE_SAMPLE' {
        publishDir = [
            path: { "${params.outdir}/mapped_reads/merged_per_sample/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMREMOVEDUP_SAMPLE' {
        publishDir = [
            path: { "${params.outdir}/mapped_reads/merged_per_sample_samremovedup2/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK_INDELREALIGNER' {
        publishDir = [
            path: { "${params.outdir}/mapped_reads/indels_realigned/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // PROCESSED_MAPPED_READS_QC
    withName: 'FASTQC_PROCESSED' {
        publishDir = [
            path: { "${params.outdir}/processed_mapped_reads_qc/processed_reads/FastQC/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/processed_mapped_reads_qc/processed_reads/multiqc/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAPDAMAGE2' {
        publishDir = [
            path: { "${params.outdir}/processed_mapped_reads_qc/mapped_reads/MapDamage2/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AMBER' {
        publishDir = [
            path: { "${params.outdir}/processed_mapped_reads_qc/mapped_reads/AMBER/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUALIMAP_BAMQC' {
        publishDir = [
            path: { "${params.outdir}/processed_mapped_reads_qc/mapped_reads/QualiMap/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_BAM' {
        publishDir = [
            path: { "${params.outdir}/processed_mapped_reads_qc/mapped_reads/multiqc/" },
            mode: params.publish_mode,
            // Groovy ternary operator: https://groovy-lang.org/operators.html#_ternary_operator
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
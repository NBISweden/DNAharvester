// Template file for pipeline configuration

// Pipeline parameters

params {

    // Pipeline inputs

    // Enter full path to samplesheet with sample IDs and paths to fastq files (incl. information if single-end or paired-end)
    // TO DO expand samplesheet to include info on strandedness and damage treatment
    samplesheet        = '/proj/sllstore2017093/b2016342/b2016342_nobackup/lts/LTS-L_Dalen_2302/read-harvester/assets/samplesheet_testdata_eager-rackham.csv'
    // Enter path to reference genome assembly
    reference          = '/proj/sllstore2017093/b2016342/b2016342_nobackup/lts/verena/testdata/nf-core_eager/test-datasets/reference/Mammoth/Mammoth_MT_Krause.fasta'

    // Pipeline steps to be run (comma-separated list, full list: 'fastq_processing,mapping,processed_fastq_raw_bam_qc,bam_processing,processed_bam_qc')
    steps              = 'fastq_processing,mapping,processed_fastq_raw_bam_qc,bam_processing,processed_bam_qc'

    // Pipeline outputs
    // Enter path to output directory
    outdir             = 'results'

    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode       = 'copy'


    // Tool specific parameters
    // Fastp
    // Enter minimum read length for a read to be kept after adapter trimming and read merging (default: 20)
    readlength         = 20

    // bwa-aln
    // Check "config/modules.config" for ancient DNA specific parameters

    // samtools view

    // AMBER

    // MapDamage2

}

// Nextflow parameters

// Execute the script using the cached results, useful to continue executions that was stopped by an error.
resume                   = true

// If run with -profile conda or -profile mamba, provide path to centralized directory with conda environments
conda.cacheDir           = null

// If run with -profile singularity, provide path to centralized directory with singularity images
singularity.cacheDir     = null

// Cluster options, e.g. for the UPPMAX compute project (like '-A snicxxx-yyy')
process.clusterOptions   = '-A naiss2023-5-22'


// limit resources for test runs with small dataset
process {

    cpus   = 1
    memory = 6.GB
    time   = 1.h

    withName: 'BWA_INDEX' {
        ext.args   = { "" } 
    }

    withLabel: process_single {
        cpus   = 1
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }
    withLabel: process_high {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_long {
        time   = 1.h
    }
    withLabel: process_high_memory {
        memory = 6.GB
    }
}
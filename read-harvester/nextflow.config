// Nextflow configuration file

manifest {
    name                      = 'Read Harvester pipeline'
    author                    = 'Verena Kutschera'
    homePage                  = 'https://github.com/NBISweden/LTS-L_Dalen_2302/read-harvester'
    description               = 'A novel pipeline for processing and analyzing extremely degraded DNA'
    mainScript                = 'main.nf'
    //  '!>=23.04.1' : Run with version 23.04.1 or higher, otherwise exit.
    nextflowVersion           = '!>=23.04.1'
    version                   = '0.1'
}

// Default pipeline parameters
// Override them in configs/custom.config
params {

    // Pipeline inputs

    // Enter full path to samplesheet with sample IDs and paths to fastq files (incl. information if single-end or paired-end)
    // TO DO expand samplesheet to include info on strandedness and damage treatment
    samplesheet               = null
    // Enter path to reference genome assembly
    reference                 = null

    // Pipeline steps to be run (comma-separated list, e.g. 'read_processing,mapping,data_qc')
    steps                     = 'read_processing'

    // Pipeline outputs
    // Enter path to output directory
    outdir                    = 'results'
    // Enter path to work directory for this run (remove directory after a successful run)
    workDir                   = 'work_run1'
    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode              = 'copy'


    // Tool specific parameters
    // Fastp
    // Enter minimum read length for a read to be kept after adapter trimming and read merging
    readlength                = 20

    // bwa-aln

    // samtools view

    // AMBER

    // MapDamage2

}

//includeConfig 'configs/nf-core-defaults.config'

// Profiles for pipeline execution

profiles {

    conda {
        params.enable_conda   = true
    }

    mamba {
        params.enable_conda   = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
        docker.userEmulation  = true
    }

    singularity {
        singularity.enabled   = true
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }

    // Test profiles
    test {
        params {
            samplesheet       = null
            reference         = null
        }
    }

    // Profiles for the Uppmax clusters
    uppmax {
        params {
            // SNIC compute allocation id
            project           = ''
        }
        process {
            executor          = 'slurm'
            clusterOptions    = { "-A $params.project" }
            // Use node local storage for execution.
            scratch           = '$SNIC_TMP'
        }
        singularity {
            enabled         = true
            envWhitelist    = 'SNIC_TMP'
        }
    }

    // A profile for running locally with Singularity
    // (e.g., using an interactive Uppmax session)
    uppmax_local {
        process {
            executor          = 'local'
            scratch           = '$SNIC_TMP'
        }
        singularity {
            enabled           = true
            envWhitelist      = 'SNIC_TMP'
        }
    }
}

//includeConfig 'configs/modules.config'

// from https://github.com/NBISweden/Earth-Biogenome-Project-pilot/blob/main/configs/nf-core-defaults.config
// nf-core label resource requirements
// check_max function removed for now

process {

    cpus   = 1
    memory = 6.GB
    time   = 4.h

    withLabel: process_low {
        cpus   = 2
        memory = 12.GB
        time   = 4.h
    }
    withLabel: process_medium {
        cpus   = 6
        memory = 36.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 12
        memory = 72.GB
        time   = 16.h
    }
    withLabel: process_long {
        time   = 20.h
    }
    withLabel: process_high_memory {
        memory = 200.GB
    }
}

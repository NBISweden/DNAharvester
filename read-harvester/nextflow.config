// Nextflow configuration file

manifest {
    name                      = 'Read Harvester pipeline'
    author                    = 'Verena Kutschera'
    homePage                  = 'https://github.com/NBISweden/LTS-L_Dalen_2302/read-harvester'
    description               = 'A novel pipeline for processing and analyzing extremely degraded DNA'
    mainScript                = 'main.nf'
    //  '!>=23.04.1' : Run with version 23.04.1 or higher, otherwise exit.
    nextflowVersion           = '!>=23.04.1'
    version                   = '0.1'
}

// Default pipeline parameters
// Override them in configs/custom.config
params {

    // Pipeline inputs

    // Enter full path to samplesheet with sample IDs and paths to fastq files (incl. information if single-end or paired-end)
    // TO DO expand samplesheet to include info on strandedness and damage treatment
    samplesheet               = null
    // Enter path to reference genome assembly
    reference                 = null

    // Pipeline steps to be run (comma-separated list, e.g. 'read_processing,mapping,data_qc')
    steps                     = 'read_processing'

    // Pipeline outputs
    // Enter path to output directory
    outdir                    = 'results'
    // Enter path to work directory for this run (remove directory after a successful run)
    workDir                   = 'work_run1'
    // Mode of copying results from the work directory, values 'symlink' or 'copy'
    publish_mode              = 'copy'


    // Tool specific parameters
    // Fastp

    // bwa-aln

    // samtools view

    // AMBER

    // MapDamage2

}

//includeConfig 'configs/nf-core-defaults.config'

// Profiles for pipeline execution

profiles {

    conda {
        params.enable_conda   = true
    }

    mamba {
        params.enable_conda   = true
        conda.useMamba        = true
    }

    docker {
        docker.enabled        = true
        docker.userEmulation  = true
    }

    singularity {
        singularity.enabled   = true
    }

    execution_report {
        timeline {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_timeline.html"
        }
        report {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_report.html"
        }
        trace {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/execution_trace.txt"
        }
        dag {
            enabled           = true
            file              = "${params.outdir}/pipeline_info/pipeline_dag.mmd"
        }
    }

    // Test profiles
    test {
        params {
            samplesheet       = null
            reference         = null
        }
    }

    // Profiles for the Uppmax clusters
    uppmax {
        params {
            // SNIC compute allocation id
            project           = ''
        }
        process {
            executor          = 'slurm'
            clusterOptions    = { "-A $params.project" }
            // Use node local storage for execution.
            scratch           = '$SNIC_TMP'
        }
        singularity {
            enabled         = true
            envWhitelist    = 'SNIC_TMP'
        }
    }

    // A profile for running locally with Singularity
    // (e.g., using an interactive Uppmax session)
    uppmax_local {
        process {
            executor          = 'local'
            scratch           = '$SNIC_TMP'
        }
        singularity {
            enabled           = true
            envWhitelist      = 'SNIC_TMP'
        }
    }
}

//includeConfig 'configs/modules.config'

// from nf-core pipeline-template base.config file https://github.com/nf-core/tools/blob/master/nf_core/pipeline-template/conf/base.config
process {

    // TODO nf-core: Check the defaults for all processes
    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 6.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { check_max( 1                  , 'cpus'    ) }
        memory = { check_max( 6.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 4.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_low {
        cpus   = { check_max( 2     * task.attempt, 'cpus'    ) }
        memory = { check_max( 12.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 4.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_medium {
        cpus   = { check_max( 6     * task.attempt, 'cpus'    ) }
        memory = { check_max( 36.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 8.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_high {
        cpus   = { check_max( 12    * task.attempt, 'cpus'    ) }
        memory = { check_max( 72.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 16.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_long {
        time   = { check_max( 20.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_high_memory {
        memory = { check_max( 200.GB * task.attempt, 'memory' ) }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}